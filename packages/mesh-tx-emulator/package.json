{
  "name": "@meshsdk/tx-emulator",
  "version": "1.9.1",
  "description": "Simulate and submit Cardano transactions against a local ledger",
  "main": "./dist/index.cjs",
  "browser": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build:mesh": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf node_modules",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "pack": "npm pack --pack-destination=./dist",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@meshsdk/common": "1.9.1",
    "@meshsdk/core-cst": "1.9.1",
    "@meshsdk/scalus-emulator": "1.9.1",
    "scalus": "^1.3.0"
  },
  "peerDependencies": {
    "@cardananium/cquisitor-lib": "^0.1.0-beta.68"
  },
  "peerDependenciesMeta": {
    "@cardananium/cquisitor-lib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cardananium/cquisitor-lib": "0.1.0-beta.68",
    "@meshsdk/configs": "*",
    "@meshsdk/core": "1.9.1",
    "@meshsdk/wallet": "1.9.1",
    "eslint": "^8.57.0",
    "ts-jest": "^29.1.4",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "prettier": "@meshsdk/configs/prettier",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "cardano",
    "ada",
    "web3",
    "blockchain",
    "sdk",
    "emulator"
  ]
}
